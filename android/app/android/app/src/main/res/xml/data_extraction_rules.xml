<?xml version="1.0" encoding="utf-8"?>
<!-- Data pengguna (proyek, model, rekaman suara) tidak ikut backup/transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
